{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    // The CAS, the jet layer and the mesh builder index arrays constantly; an
    // out-of-bounds read there is a silent wrong-geometry bug, not a crash.
    "noUncheckedIndexedAccess": true,

    "types": ["vitest/globals", "vite/client"]
  },
  // `docs` is in the program so that the reference page's `Record<ItemKind, …>` tables are
  // checked for exhaustiveness: adding a kind of row, a diagnostic or a geodesic stop reason then
  // fails the build until it is documented.
  "include": ["src", "tests", "docs"]
}
